@model UCL_Ticketverkoop.ViewModels.ClubMatchVM
<link href="~/css/MatchCalendar.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Matches";
}

<h1>Matches</h1>

<div class="row">
    <div class="col-md-8">
        <form id="clubFilterForm"
              asp-action="getMatchesByClubs"
              data-ajax="true"
              data-ajax-method="POST"
              data-ajax-mode="replace"
              data-ajax-update="#calendarResults"
              data-ajax-loading="#divloading"
              data-ajax-success="Success"
              data-ajax-failure="Failure">
            <div class="calendar-filters">
                <div class="form-group season-filter">
                    <label for="SeasonID" class="control-label">Season</label>
                    <select asp-for="SeasonID" asp-items="@Model.Seasons" id="SeasonID" name="SeasonID">
                    </select>
                </div>

                <div class="form-group club-filter">
                    <label for="ClubID" class="control-label">Club</label>
                <select asp-for="ClubID" asp-items="@Model.Clubs" id="ClubID" name="ClubID">
                    <option value="">All clubs</option>
                </select>
                </div>
            </div>
        </form>
    </div>
</div>

<img id="divloading"
     src="~/Images/spinner.webp"
     style="display: none" />
<div id="calendarResults">
    <partial name="_MatchCalendarResults" model="Model" />
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    <script>
        $("#ClubID, #SeasonID").on("change", () =>
         {
                $("#clubFilterForm").trigger("submit");
         });

         let Success = () => {
            $("#divloading").hide();
         }
    </script>
}
