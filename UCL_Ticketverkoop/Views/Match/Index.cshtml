@model UCL_Ticketverkoop.ViewModels.ClubMatchVM
<link href="~/css/MatchCalendar.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Matches";
}

<h1>matches:</h1>


<div class="row">
    <div class="col-md-4">
        <form asp-action="getMatchesByClubs"
              data-ajax="true"
              data-ajax-method="POST"
              data-ajax-mode="replace"
              data-ajax-update="#content"
              data-ajax-loading="#divloading"
              data-ajax-success="Success"
              data-ajax-failure="Failure">
            <div class="form-group">
                <label for="ClubID" class="control-label"></label>
                <select asp-for="ClubID" asp-items="@Model.Clubs" id="ClubID" name="ClubID">
                    <option>All clubs</option>
                </select>
            </div>
        </form>
    </div>
</div>

<img id="divloading"
     src="~/Images/spinner.webp"
     style="display: none" />
<div id="content">
    <partial name="_MatchData" model="Model.Matches" />
</div>>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    <script>
        $("#ClubID").on("change", () =>
         {
                $("form").trigger("submit");
         });

         let Success = () => {
            $("#divloading").hide();
         }
    </script>
}