@model IEnumerable<UCL_Ticketverkoop.ViewModels.MatchVM>
<link href="~/css/MatchCalendar.css" rel="stylesheet" />

<div class="match-list">
    @foreach (var item in Model)
    {
        <div class="match-card">
            <div class="match-date-badge">
                <span class="match-day">@item.MatchDate.ToString("dd")</span>
                <span class="match-month">@item.MatchDate.ToString("MMM")</span>
                <span class="match-time">@item.MatchDate.ToString("HH:mm")</span>
            </div>

            <div class="match-teams">
                <div class="team home">
                    <img src="/Images/@item.HomeTeamLogoUrl" alt="@item.HomeTeamName" class="team-logo" />
                    <span class="team-name">@item.HomeTeamName</span>
                </div>

                <div class="match-vs">
                    <span>VS</span>
                </div>

                <div class="team away">
                    <img src="/Images/@item.AwayTeamLogoUrl" alt="@item.AwayTeamName" class="team-logo" />
                    <span class="team-name">@item.AwayTeamName</span>
                </div>
            </div>

            <div class="match-meta">
                <span class="match-stadium">@item.StadiumName</span>
            </div>

            <div class="match-action">
                @Html.ActionLink("Buy tickets", "Index", "SeatSelect",
                new { stadiumId = item.HomeTeam.Stadium.Id, matchId = item.Id },
                        new { @class = "btn-ticket" })
            </div>
        </div>
    }
</div>