@model UCL_Ticketverkoop.ViewModels.MatchVM

@{
    ViewData["Title"] = "Index";
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<h1>Index</h1>

<div class="stadium-container">
    @foreach (var vak in Model.vaks)
    {
        <div class="vak-container">
            <h3>Vak: @vak.Name</h3>
            <div>
                @for (int i = 0; i < vak.Rows; i++)
                {
                    <div>
                    @for (int j = 0; j < vak.SeatsPerRow; j++)
                    {
                            <a asp-Controller="SeatSelect" asp-action="SelectSeat"
                            asp-route-MatchId="@Model.Id"
                            asp-route-VakId="@vak.Id"
                            asp-route-Seat="@($"{i+1}-{j+1}")"
                            
                            >S</a>
                    }
                    </div>
                }
            </div>
        </div>
    }
</div>

