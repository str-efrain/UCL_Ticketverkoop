@model UCL_Ticketverkoop.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

@foreach (var item in Model.Tickets) {
        <tr>
            <td>
                  @item.Match.HomeTeamName
            </td>
            <td>
            @item.Match.AwayTeamName
            </td>
            <td>
                @item.Vak.Name
                    stoeltje: @item.Seat
            </td>
        <td>
           € @item.Vak.Price
        </td>
        <td>
            <a asp-Controller="ShoppingCart" asp-action="Delete" asp-route-id="@item.Id" >verwijder</a>
        </td>
        </tr>
}
€ @Model.TotalPrice

                            <a asp-Controller="ShoppingCart" asp-action="Buy"
                            >Buy</a>
    </tbody>
</table>
