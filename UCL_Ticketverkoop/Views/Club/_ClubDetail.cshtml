@model UCL_Ticketverkoop.ViewModels.ClubVM

<div class="club-detail-container">
    <div class="club-info">
        <h4>@Model.Name</h4>
        <p>
            <span class="label">Stadium:</span><br />
            @if (Model.StadiumID != null)
            {
                <a asp-controller="Stadium" asp-action="Details" asp-route-id="@Model.StadiumID" class="stadium-link">
                    @Model.StadiumName
                </a>
            }
            else
            {
                <span class="no-stadium">No stadium assigned</span>
            }
        </p>
    </div>

    <div class="club-photo-wrapper">
            <img src="@Model.LogoUrl" class="club-logo-img" alt="@Model.Name" />
    </div>
</div>