@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
}

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- HERO                                                        -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="hp-hero rounded-3 mb-4">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="hp-eyebrow">@Localizer["ucl_tickets"]</p>
            <h1 class="hp-hero-title">
                @Localizer["your seat at"]<br />
                @Localizer["europe's"] <span class="hp-accent">@Localizer["greatest stage"]</span>
            </h1>
            <p class="hp-hero-desc">
                @Localizer["description hero"]
            </p>
            <div class="hp-cta-group">
                <a asp-controller="Match" asp-action="Index" class="hp-btn-primary">@Localizer["browse_matches"]</a>
                <a asp-controller="Club" asp-action="Index" class="hp-btn-outline">@Localizer["view_clubs"]</a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-flex justify-content-center">
            <div class="hp-emblem-wrap">
                <img src="~/images/ucl.svg" alt="UEFA Champions League" class="hp-ucl-logo" />
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- STATS STRIP                                                 -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="hp-stats rounded-3 mb-4">
    <div class="row text-center g-0">
        <div class="col-6 col-md-3">
            <div class="hp-stat">
                <div class="hp-stat-value">6</div>
                <div class="hp-stat-label">@Localizer["topclubs"]</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="hp-stat">
                <div class="hp-stat-value">30+</div>
                <div class="hp-stat-label">@Localizer["matches_available"]</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="hp-stat">
                <div class="hp-stat-value">100%</div>
                <div class="hp-stat-label">@Localizer["secure_checkout"]</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="hp-stat">
                <div class="hp-stat-value">24/7</div>
                <div class="hp-stat-label">@Localizer["support"]</div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ABOUT                                                       -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="mb-5">
    <div class="row align-items-center g-4">
        <div class="col-md-7">
            <p class="hp-eyebrow">@Localizer["about_us"]</p>
            <h2 class="hp-section-title">@Localizer["one_platform"]<br />@Localizer["every_ucl_ticket"]</h2>
            <p class="hp-section-body">
                @Localizer["we_centralize"]
            </p>
            <p class="hp-section-body mt-3">
                @Localizer["no_more_juggling"]
            </p>
        </div>
        <div class="col-md-5">
            <div class="hp-about-visual rounded-3 d-flex flex-column align-items-center justify-content-center gap-3">
                <img src="~/images/ucl.svg" alt="UEFA Champions League" class="hp-ucl-logo hp-ucl-logo-lg" />
                <span class="hp-visual-caption">@Localizer["ucl"]</span>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- HOW IT WORKS                                                -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="hp-how-wrap rounded-3 mb-4 p-4 p-md-5">
    <p class="hp-eyebrow">@Localizer["how_it_works"]</p>
    <h2 class="hp-section-title">@Localizer["four_steps"]</h2>
    <div class="row g-3 mt-2">
        <div class="col-sm-6 col-lg-3">
            <div class="hp-step-card h-100">
                <div class="hp-step-num">01</div>
                <div class="hp-step-icon">🏟️</div>
                <div class="hp-step-title">@Localizer["choose_club"]</div>
                <p class="hp-step-body">@Localizer["choose_club_desc"]</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hp-step-card h-100">
                <div class="hp-step-num">02</div>
                <div class="hp-step-icon">🎟️</div>
                <div class="hp-step-title">@Localizer["pick_match"]</div>
                <p class="hp-step-body">@Localizer["pick_match_desc"]</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hp-step-card h-100">
                <div class="hp-step-num">03</div>
                <div class="hp-step-icon">✅</div>
                <div class="hp-step-title">@Localizer["secure_seat"]</div>
                <p class="hp-step-body">@Localizer["secure_seat_desc"]</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hp-step-card h-100">
                <div class="hp-step-num">04</div>
                <div class="hp-step-icon">📲</div>
                <div class="hp-step-title">@Localizer["enjoy_match"]</div>
                <p class="hp-step-body">@Localizer["enjoy_match_desc"]</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- WHY EFRATHIB                                                -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="mb-4">
    <p class="hp-eyebrow">@Localizer["why_efrathib"]</p>
    <h2 class="hp-section-title">@Localizer["real_fans"]</h2>
    <div class="row g-3 mt-1">
        <div class="col-sm-6 col-lg-3">
            <div class="hp-feature-card h-100">
                <div class="hp-feature-icon">🔒</div>
                <div class="hp-feature-title">@Localizer["verified"]</div>
                <p class="hp-feature-body">@Localizer["verified_desc"]</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hp-feature-card h-100">
                <div class="hp-feature-icon">⚡</div>
                <div class="hp-feature-title">@Localizer["real_time"]</div>
                <p class="hp-feature-body">@Localizer["real_time_desc"]</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hp-feature-card h-100">
                <div class="hp-feature-icon">🌍</div>
                <div class="hp-feature-title">@Localizer["major"]</div>
                <p class="hp-feature-body">@Localizer["major_desc"]</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hp-feature-card h-100">
                <div class="hp-feature-icon">👤</div>
                <div class="hp-feature-title">@Localizer["one_account"]</div>
                <p class="hp-feature-body">@Localizer["one_account_desc"]</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- CTA BANNER                                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="hp-cta-banner rounded-3 text-center mb-4">
    <h2 class="hp-cta-banner-title">@Localizer["cta"]</h2>
    <p class="hp-cta-banner-sub">@Localizer["cta_desc"]</p>
    <div class="hp-cta-group justify-content-center">

        <a asp-area="Identity" asp-page="/Account/Register" class="hp-btn-primary">@Localizer["create_account"]</a>
        <a asp-controller="Match" asp-action="Index" class="hp-btn-outline">@Localizer["see_matches"]</a>
    </div>
</section>
