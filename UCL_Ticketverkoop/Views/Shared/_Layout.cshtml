<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UCL_Ticketverkoop</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/svg" href="~/images/ucl.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UCL_Ticketverkoop.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        <nav class="navbar">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                EfraThib<span>_Ticketing</span>
            </a>

            <div class="nav-links">
                <a class="@(currentController == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    Home
                </a>

                <a class="@(currentController == "Club" || currentController == "Stadium" ? "active" : "")"
                   asp-controller="Club" asp-action="Index">
                    Clubs
                </a>

                <a class="@(currentController == "Match" || currentController == "SeatSelect" ? "active" : "")"
                   asp-controller="Match" asp-action="Index">
                    Matchcalendar
                </a>
                <a class="@(currentController == "ShoppingCart" || currentController == "Checkout" ? "active" : "")"
                   asp-controller="ShoppingCart" asp-action="Index">
                    ShoppingCart
                </a>
                <a class="@(currentController == "History" ? "active" : "")"
                   asp-controller="History" asp-action="Index">
                    Order History
                </a>
                <a class="@(currentController == "Hotel" ? "active" : "")"
                   asp-controller="Hotel" asp-action="Index">
                    Hotels
                </a>
            </div>

            @await Html.PartialAsync("_SelectCulture")

            <div class="nav-auth">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EfraThib_Ticketing - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        console.log('ok');

        $(document).ready(() => {
            $('.setLang').change(function () {
                $('#selectLanguage').submit();
            });
        });

    </script>
</body>
</html>
